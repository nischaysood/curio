<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the composed waveforms behind COMPLETE and STREAK.
         Everything else uses View.performHapticFeedback, which needs no permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Course generation. The app works fully without it — bundled courses are
         checked first and answer offline — so this is for unknown topics only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Curio"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Curio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
